{
  "crons": [
    {
      "path": "/api/cron/rules",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/reset-daily",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/cron/reconcile-reserves",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/sweep-burl",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/optimize",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/ord-export",
      "schedule": "0 3 2 * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "30 2 * * *"
    }
  ],
  "services": {
    "frontend": {
      "root": "frontend/"
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
