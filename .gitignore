# ─────────────────────────────────────────
# Central DSP .gitignore
# ─────────────────────────────────────────

# Secrets — NEVER commit these
.env
*.pem
*.key
*.p12
secrets/

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/

# Node / Vue
node_modules/
dist/
.vite/
.nuxt/
.output/

# Java / Maven
target/
*.class
*.jar
*.war
*.ear
.mvn/

# Docker volumes
postgres_data/
redis_data/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.swp
*.swo
*.iml

# Logs
*.log
logs/

# Backups
backups/*.sql
backups/*.dump

# GeoIP DB (large binary file, download separately)
*.mmdb
GeoLite2-*/

# Test artifacts
.pytest_cache/
htmlcov/
.coverage
coverage.xml
