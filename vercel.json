{
  "crons": [
    { "path": "/api/cron/rules", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/reset-daily", "schedule": "0 0 * * *" }
  ],
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/"
    },
    "backend": {
      "entrypoint": "backend/main.py",
      "routePrefix": "/api"
    }
  }
}
