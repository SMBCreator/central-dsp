# ─────────────────────────────────────────────────────────────
# CentralDSP — Environment Variables (актуально для гибрид-стека)
# Vercel (UI + management API + ОРД + cron)  |  Bid-сервис (Fly.io/VPS)
# Скопируйте в .env и заполните. НИКОГДА не коммитьте .env!
# ─────────────────────────────────────────────────────────────

# ── Режим ────────────────────────────────────────────────────
# production: backend и bidder-go падают на старте, если секреты ниже пустые,
# плейсхолдерные или короче 32 символов (backend/startup_checks.py).
# Локальная разработка: APP_ENV=dev (проверки только логируются).
APP_ENV=production

# ── База данных (Neon Postgres) ──────────────────────────────
# Оба сервиса используют одну БД. Bid-сервис — pooled URL.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# ── Redis — деньги торгов: spend:*, резервы, dedup, bidmeta, rtb:events ─
# ОДИН И ТОТ ЖЕ URL у backend и bidder-go (compose подставляет его обоим).
# Требования (audit M-03): maxmemory-policy=noeviction (иначе production не
# стартует), AOF или RDB. Локальный compose-Redis уже настроен так; для
# внешнего/managed Redis проверьте политику: redis-cli CONFIG GET maxmemory-policy
# Локальный compose: оставить пустым (redis://redis:6379/0). Fallback: KV_URL.
REDIS_URL=
# Лимит памяти compose-Redis; при исчерпании — ошибки записи (no-bid), не eviction.
REDIS_MAXMEMORY=1gb

# ── Auth / сессии ────────────────────────────────────────────
# openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32
# HMAC-подпись win/imp/click токенов. В production обязателен (иначе бэкенд не стартует).
EVENT_TOKEN_SECRET=CHANGE_ME_openssl_rand_hex_32

# ── Внутренние сервисные токены (docker-compose требует их явно) ──
# Общий токен backend <-> bidder (feed + RTB bridge). openssl rand -hex 32
RTB_API_TOKEN=CHANGE_ME_openssl_rand_hex_32
# Flower (мониторинг Celery). Порт 5555 слушает только 127.0.0.1.
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_ME_strong_password
# open | closed. closed (default) = самостоятельно регистрируется только первый
# пользователь (superadmin), остальных заводит админ. Неизвестное значение —
# fail-fast в production (audit S-04).
REGISTRATION_MODE=closed
# CSRF (audit S-01): публичные origin'ы UI через запятую. Мутирующий запрос
# с другим Origin/Referer получает 403. Без переменной гейт сверяет источник
# с Host/X-Forwarded-Host (за Caddy/Vercel это публичный хост) и пишет warning.
PUBLIC_ORIGINS=https://dsp.example.com
# SameSite сессионной cookie: lax (default в production). none — ТОЛЬКО если UI
# открывается в чужом iframe (превью v0); вне production default none.
# AUTH_COOKIE_SAMESITE=lax

# ── RTB / биддер ─────────────────────────────────────────────
# HMAC-секрет подписи win/imp/click/vevent URL. openssl rand -hex 32
EVENT_TOKEN_SECRET=CHANGE_ME_openssl_rand_hex_32
RTB_CURRENCY=RUB
# TTL кэша кандидатов (сек): пауза кампании видна биддеру в пределах TTL
RTB_CACHE_TTL=30
# ТОЛЬКО для dev/симулятора. В production игнорируется и валит старт (S-04).
# RTB_ALLOW_UNSIGNED_EVENTS=1

# ── ОРД Ozon (маркировка рекламы, erid) ──────────────────────
# Без ключа работает MockOrdAdapter (детерминированные erid для dev/CI)
ORD_OZON_API_KEY=
ORD_OZON_BASE_URL=https://ord.ozon.ru/api
# off = отключить launch guard (ТОЛЬКО dev). В проде кампания без erid не стартует.
ORD_LAUNCH_GUARD=on

# ── Cron (Vercel Cron → /cron/*) ─────────────────────────────
# openssl rand -hex 32
CRON_SECRET=CHANGE_ME_openssl_rand_hex_32
# Python-биддер (reference/dev). Default: включён вне production, выключен в
# production; RTB_PYTHON_SERVING=true при APP_ENV=production валит старт (S-04).
RTB_PYTHON_SERVING=true
