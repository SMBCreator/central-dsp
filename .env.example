# ─────────────────────────────────────────
# Central DSP — Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to git!
# ─────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=centraldsp
POSTGRES_USER=centraldsp
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://centraldsp:CHANGE_ME_STRONG_PASSWORD@postgres:5432/centraldsp

# Redis
REDIS_URL=redis://redis:6379/0

# FastAPI / JWT
JWT_SECRET_KEY=CHANGE_ME_256_BIT_RANDOM_STRING_HERE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Encryption (for ad network credentials storage)
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_AES_KEY_HERE

# First admin user (auto-created on first start if users table empty)
FIRST_ADMIN_EMAIL=admin@centraldsp.local
FIRST_ADMIN_PASSWORD=admin123

# Domain (for Caddy in production)
DOMAIN=ads.local

# Notifications (Apprise)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Ad Networks
PUSH_HOUSE_API_TOKEN=
YANDEX_DIRECT_OAUTH_TOKEN=
KADAM_API_TOKEN=
PROPELLERADS_API_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# GeoIP (MaxMind — for production, register at maxmind.com)
MAXMIND_LICENSE_KEY=
MAXMIND_ACCOUNT_ID=

# ─────────────────────────────────────────
# RTB / Bidder Configuration
# ─────────────────────────────────────────

# Shared secret between backend and bidder
# Generate with: openssl rand -hex 32
RTB_API_TOKEN=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# Bidder connection (used by backend to check bidder status)
RTB_BIDDER_HOST=bidder
RTB_BIDDER_PORT=8080

# Bid price limits (CPM, USD)
RTB_DEFAULT_BID_FLOOR=0.01
RTB_MAX_BID_PRICE=5.00
RTB_RESPONSE_TIMEOUT_MS=100

# Celery Flower
FLOWER_USER=admin
FLOWER_PASSWORD=admin123

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info
