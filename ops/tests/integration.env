# Окружение integration-стека (ops/tests/integration_smoke.sh, CI job integration).
# APP_ENV=production НАМЕРЕННО: стек стартует в том же режиме, что и на VPS,
# со всеми startup-проверками backend (startup_checks.py) и bidder-go
# (internal/config): секреты >= 32 символов и не плейсхолдеры, публичный
# EVENT_BASE_URL, noeviction+AOF Redis. Значения — фиктивные, ни к чему
# внешнему не подключаются, с production .env не совпадают (guard в скрипте).
APP_ENV=production
POSTGRES_DB=centraldsp_ci_it
POSTGRES_USER=centraldsp_ci_it
POSTGRES_PASSWORD=ci-it-pg-pass-not-a-secret-0123456789abcdef
REDIS_MAXMEMORY=128mb
SESSION_SECRET=ci-it-session-secret-not-a-secret-0123456789abcdef
EVENT_TOKEN_SECRET=ci-it-event-token-secret-not-a-secret-0123456789abcdef
RTB_API_TOKEN=ci-it-rtb-api-token-not-a-secret-0123456789abcdef
CRON_SECRET=ci-it-cron-secret-not-a-secret-0123456789abcdef
# Публичный по форме адрес (не loopback / не имя сервиса compose): иначе
# bidder-go в production не стартует (audit O-01). Никуда не резолвится.
PUBLIC_BASE_URL=https://ci-it.centraldsp.example
# ОРД в CI не настраивается; без ORD_REQUIRED=0 production-backend не стартует (L-01).
ORD_REQUIRED=0
REGISTRATION_MODE=closed
