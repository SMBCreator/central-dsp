# Окружение изолированного drill-стека (COMPOSE_ENV_FILES указывает сюда).
# Значения намеренно не совпадают с production .env — guard в drill проверяет,
# что база/volume не production.
POSTGRES_DB=centraldsp_ci
POSTGRES_USER=centraldsp_ci
POSTGRES_PASSWORD=drill-only-not-a-secret
REDIS_MAXMEMORY=128mb
DRILL_PG_PORT=55432
DRILL_REDIS_PORT=56379
# Обязательные ${VAR:?} из compose.yml (backend не запускается, но `compose config`
# валидирует весь файл). Фиктивные значения, ни к чему не подключаются.
RTB_API_TOKEN=drill-rtb-token-not-a-secret
EVENT_TOKEN_SECRET=drill-event-secret-not-a-secret
SESSION_SECRET=drill-session-secret-not-a-secret
CRON_SECRET=drill-cron-secret-not-a-secret
PUBLIC_BASE_URL=http://drill.invalid
