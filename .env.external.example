# ─────────────────────────────────────────────────────────────
# Central DSP — дополнение к .env для managed Postgres/Redis.
# Берите .env.example за основу и ДОБАВЬТЕ/замените эти строки.
# ─────────────────────────────────────────────────────────────

# Встроенные postgres/redis не стартуют; зависимости на них сняты.
COMPOSE_FILE=compose.yml:compose.external.yml:compose.prod.yml

# Managed Postgres (миграции всё равно накатывает backend/migrate.py при старте).
DATABASE_URL=postgresql://centraldsp:PASSWORD@pg.example.internal:5432/centraldsp?sslmode=require

# Managed Redis. Требования те же, что к встроенному (audit M-03):
#   * maxmemory-policy = noeviction  (иначе production не стартует —
#     backend/startup_checks.py и bidder-go проверяют CONFIG GET на старте);
#   * персистентность AOF или RDB;
#   * один URL для backend и bidder-go (compose подставляет обоим).
# Проверка: redis-cli -u "$REDIS_URL" CONFIG GET maxmemory-policy
REDIS_URL=rediss://default:PASSWORD@redis.example.internal:6380/0

# POSTGRES_PASSWORD не нужен — оставьте пустым или удалите.
