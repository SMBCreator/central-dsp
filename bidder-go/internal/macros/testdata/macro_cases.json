  "template": "https://l.example/?c=${CDSP_COUNTRY}}",
  "values": {
   "COUNTRY": "KZ"
  },
  "want": "https://l.example/?c=KZ}"
 },
 {
  "name": "лишний доллар перед макросом",
  "template": "https://l.example/?c=$${CDSP_COUNTRY}",
  "values": {
   "COUNTRY": "KZ"
  },
  "want": "https://l.example/?c=$KZ"
 },
 {
  "name": "пробел в имени макроса",
  "template": "https://l.example/?c=${CDSP_COUNTRY }",
  "values": {
   "COUNTRY": "KZ"
  },
  "want": "https://l.example/?c=${CDSP_COUNTRY }"
 },
 {
  "name": "вложенный макрос",
  "template": "https://l.example/?c=${CDSP_${CDSP_COUNTRY}}",
  "values": {
   "COUNTRY": "KZ"
  },
  "want": "https://l.example/?c=${CDSP_KZ}"
 },
 {
  "name": "кириллица в статической части",
  "template": "https://l.example/путь?c=${CDSP_COUNTRY}",
  "values": {
   "COUNTRY": "KZ"
  },
  "want": "https://l.example/путь?c=KZ"
 },
 {
  "name": "макрос в начале строки",
  "template": "${CDSP_COUNTRY}-x",
  "values": {
   "COUNTRY": "KZ"
  },
  "want": "KZ-x"
 },
 {
  "name": "строка только из макроса",
  "template": "${CDSP_COUNTRY}",
  "values": {
   "COUNTRY": "KZ"
  },
  "want": "KZ"
 },
 {
  "name": "длинное значение",
  "template": "https://l.example/?x=${CDSP_CITY}",
  "values": {
   "CITY": ""
  },
  "want": "https://l.example/?"
 },
